# Fase 2 — copia este archivo a .env y rellena con tu proyecto de Supabase
# (Settings → API en el panel de Supabase). Sin esto el juego va 100 % offline.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY

# Clave pública VAPID para notificaciones push (genera el par con:
# npx web-push generate-vapid-keys; la privada va a los secrets de Supabase)
VITE_VAPID_PUBLIC_KEY=TU-VAPID-PUBLIC-KEY
